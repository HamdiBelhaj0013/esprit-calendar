# Copy this file to .env (same folder) and fill it in. .env is git-ignored: it never leaves your PC.

# Path to the service account key you downloaded from Google Cloud (put the file in this folder)
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# Gmail address + 16-character app password (used to email you the PDF). Leave empty to skip emails.
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=
# MAIL_TO=another@address.com

# Optional — only if your downloads go somewhere unusual (the real Downloads folder is detected automatically)
# DOWNLOADS_DIR=C:\Users\you\Downloads
# PDF_PATTERN=emploi_du_temps*.pdf
